# Optional local development tokens. If omitted, run.py generates and prints them.
# RESOLVEDESK_TOKEN=
# RESOLVEDESK_REVIEW_TOKEN=
# Set to 1 for named-user-only authentication (create users with manage.py first).
RESOLVEDESK_DISABLE_TOKENS=0
# Optional AI provider. Ticket text and account evidence are sent only when configured.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESOLVEDESK_DAILY_AI_LIMIT=200
# Optional read-only Zendesk ticket import.
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# Optional independent reference account service. Both services need the same token.
# ACCOUNT_API_URL=http://127.0.0.1:8001
# ACCOUNT_API_TOKEN=
